# Copy to .env. scripts/bootstrap.sh generates local-only credentials if absent.
DATABASE_URL=postgresql+psycopg://aho:aho@localhost:5432/aho
POSTGRES_PASSWORD=aho
JWT_SECRET=
ADMIN_INITIAL_EMAIL=admin@example.local
ADMIN_INITIAL_PASSWORD=
DEMO_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Explicit opt-in only when migrating a bot from an existing webhook integration.
TELEGRAM_REPLACE_WEBHOOK=false
# Required AXO recipient for simple Telegram requests; 0 means not configured.
TELEGRAM_REQUEST_RECEIVER_ID=0
# Channel destination takes precedence; bot requires Post Messages permission.
AHO_TELEGRAM_CHAT_ID=
REGISTRATION_MODE=ADMIN_APPROVAL
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
ENVIRONMENT=development
COOKIE_SECURE=false
